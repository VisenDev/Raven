;; handle). Return R_TRUE to accept: while the pointer is over the target this
;; shows the "can drop here" cursor and highlights the target; for
;; R_DROP_DROPPED it tells the source that the data was taken.
(cl:defmacro define-rdropcallback (name arguments cl:&body body)
  "Define a C callback; ARGUMENTS supplies one Lisp name per C parameter."
  (cl:destructuring-bind (a0 a1 a2) arguments
    `(cffi:defcallback ,name :int
         ( (,a0 :uint32) (,a1 :pointer) (,a2 :pointer))
       ,@body)))

;; Called when the user asks to close the window.
;; Return R_TRUE to let the window close, R_FALSE to keep it open.
(cl:defmacro define-rwindowclosecallback (name arguments cl:&body body)
  "Define a C callback; ARGUMENTS supplies one Lisp name per C parameter."
  (cl:destructuring-bind (a0 a1) arguments
    `(cffi:defcallback ,name :int
         ( (,a0 :uint32) (,a1 :pointer))
