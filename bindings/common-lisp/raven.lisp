         ( (,a0 :pointer) (,a1 :int) (,a2 :pointer))
       ,@body)))

;; Tags made by code. A library or an application that builds a widget of
;; its own (a R_WIDGET_CUSTOM with its callbacks, or an assembly of
;; widgets) can give it a tag: documents then write <MyWidget .../> as
;; they write <Button/>.
;;
;; `create` makes the widget and returns it. `set_attribute` (may be
;; NULL) receives the attributes of the element before Raven looks at
;; them: it returns R_TRUE for those it understands, R_FALSE to leave
;; them to the widget (Name, Width, Slot..., and what its type knows).
;; Rwidget_set_attribute goes through it too.
(cl:defmacro define-rxmltagcreatecallback (name arguments cl:&body body)
  "Define a C callback; ARGUMENTS supplies one Lisp name per C parameter."
  (cl:destructuring-bind (a0 a1) arguments
    `(cffi:defcallback ,name :uint32
         ( (,a0 :pointer) (,a1 :pointer))
       ,@body)))

(cl:defmacro define-rxmltagattributecallback (name arguments cl:&body body)
  "Define a C callback; ARGUMENTS supplies one Lisp name per C parameter."
  (cl:destructuring-bind (a0 a1 a2 a3) arguments
    `(cffi:defcallback ,name :int
         ( (,a0 :uint32) (,a1 :pointer) (,a2 :pointer) (,a3 :pointer))
       ,@body)))

(cl:defmacro define-rlocalechangedcallback (name arguments cl:&body body)
  "Define a C callback; ARGUMENTS supplies one Lisp name per C parameter."
  (cl:destructuring-bind (a0 a1) arguments
    `(cffi:defcallback ,name :void
         ( (,a0 :pointer) (,a1 :pointer))
       ,@body)))

