;; Registers a function called once per frame, before the layout.
;; The body of your loop does the same job; the callback is also called
;; while the OS keeps the thread in a loop of its own (on Windows, while
;; the user moves or resizes a window), when your loop is not running.
(cl:defmacro define-rframecallback (name arguments cl:&body body)
  "Define a C callback; ARGUMENTS supplies one Lisp name per C parameter."
  (cl:destructuring-bind (a0 a1) arguments
    `(cffi:defcallback ,name :void
         ( (,a0 :double) (,a1 :pointer))
       ,@body)))

(cl:defmacro define-rtaskcallback (name arguments cl:&body body)
  "Define a C callback; ARGUMENTS supplies one Lisp name per C parameter."
  (cl:destructuring-bind (a0) arguments
    `(cffi:defcallback ,name :void
         ( (,a0 :pointer))
       ,@body)))

